{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "legendary-os",
  "main": "backend/src/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "legendary-os-cms",
      "database_id": "716b1626-4ffb-42d3-8d98-b45a6333f1bf"
    }
  ]

  // Add further durable bindings only when their owning domain is implemented.
  // Prefer service bindings for independently deployed capability workers.
  // Keep secrets out of this file; install them with Wrangler secrets.
}
