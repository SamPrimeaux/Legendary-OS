{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "legendary-os",
  "main": "backend/src/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "legendary-os-cms",
      "database_id": "716b1626-4ffb-42d3-8d98-b45a6333f1bf"
    }
  ],

  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "legendary-os"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CMS_CACHE",
      "id": "22d060ed2a4a4619afcf3a693b2210f4"
    }
  ],

  "images": {
    "binding": "IMAGES"
  }

  // CMS and media currently share the Legendary D1 binding while remaining separate domains.
  // Originals live in R2; Cloudflare Images is a transform rail, not asset identity.
  // Keep secrets out of this file; install them with Wrangler secrets.
}
