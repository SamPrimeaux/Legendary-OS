{
  "name": "legendary-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "bin": {
    "los": "./bin/los.mjs"
  },
  "scripts": {
    "los": "node bin/los.mjs",
    "dev": "pnpm --parallel --filter ./frontend --filter ./backend dev",
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:backend": "pnpm --dir backend dev",
    "build": "pnpm --dir frontend build && node scripts/sync-auth-portal.mjs && pnpm --dir backend build",
    "check": "node scripts/check.mjs",
    "deploy": "node scripts/deploy.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrate:local": "node scripts/db-migrate.mjs --local",
    "db:status": "node bin/los.mjs db status",
    "auth:sync": "node scripts/sync-auth-portal.mjs"
  }
}
